{
  "format": "ecrivain-plugin",
  "packageVersion": 1,
  "manifest": {
    "id": "analyse-dialogues",
    "name": "Analyse des dialogues",
    "version": "1.1.0",
    "author": "Exemple Écrivain",
    "description": "Analyse chaque chapitre du projet et affiche le nombre de paragraphes de dialogue, sans modifier le manuscrit.",
    "icon": "💬",
    "ecrivainApi": 1,
    "permissions": [
      "project.read",
      "chapters.read"
    ],
    "commands": [
      {
        "id": "analyser-dialogues",
        "label": "Analyser les dialogues"
      }
    ]
  },
  "code": "function textFromHtml(html) {\n    const doc = new DOMParser().parseFromString(String(html || ''), 'text/html');\n    return doc.body.textContent || '';\n}\n\nfunction countWords(text) {\n    return (String(text || '').trim().match(/\\S+/g) || []).length;\n}\n\nfunction countDialogueParagraphs(html) {\n    const doc = new DOMParser().parseFromString(String(html || ''), 'text/html');\n    const blocks = [...doc.body.querySelectorAll('p, div, blockquote')];\n    if (!blocks.length) {\n        return String(doc.body.textContent || '').split(/\\r?\\n/).filter((line) => /^\\s*—/.test(line)).length;\n    }\n    return blocks.filter((block) => /^\\s*—/.test(block.textContent || '')).length;\n}\n\nfunction escapeHtml(value) {\n    return String(value || '')\n        .replaceAll('&', '&amp;')\n        .replaceAll('<', '&lt;')\n        .replaceAll('>', '&gt;')\n        .replaceAll('\"', '&quot;')\n        .replaceAll(\"'\", '&#039;');\n}\n\necrivain.onCommand('analyser-dialogues', async () => {\n    const root = document.getElementById('plugin-root');\n    root.innerHTML = `\n        <div class=\"analysis-loading\">\n            <strong>Lecture du projet…</strong>\n            <span>Écrivain rassemble les chapitres et leur contenu.</span>\n        </div>\n    `;\n\n    const project = await ecrivain.project.getCurrent();\n    const chapters = await ecrivain.chapters.readAll();\n\n    if (!chapters.length) {\n        root.innerHTML = `\n            <div class=\"analysis-empty\">\n                <strong>Aucun chapitre à analyser.</strong>\n                <p>Créez au moins un chapitre dans le projet, puis relancez l’analyse.</p>\n            </div>\n        `;\n        ecrivain.notify('Aucun chapitre à analyser.');\n        return;\n    }\n\n    let totalDialogues = 0;\n    let totalWords = 0;\n    const rows = chapters.map((chapter) => {\n        const dialogues = countDialogueParagraphs(chapter.content);\n        const words = countWords(textFromHtml(chapter.content));\n        totalDialogues += dialogues;\n        totalWords += words;\n        return { ...chapter, dialogues, words };\n    });\n\n    const cards = rows.map((row) => `\n        <article class=\"dialogue-card\">\n            <div class=\"dialogue-card__identity\" style=\"padding-left:${Math.min(4, row.depth || 0) * 14}px\">\n                <strong>${escapeHtml(row.title || 'Sans titre')}</strong>\n                <small>${row.words.toLocaleString('fr-FR')} mots</small>\n            </div>\n            <div class=\"dialogue-card__count\">\n                <strong>${row.dialogues}</strong>\n                <span>dialogue${row.dialogues > 1 ? 's' : ''}</span>\n            </div>\n        </article>\n    `).join('');\n\n    root.innerHTML = `\n        <header class=\"plugin-title\">\n            <div>\n                <span>ANALYSE DU PROJET</span>\n                <h1>${escapeHtml(project.title || 'Manuscrit')}</h1>\n            </div>\n        </header>\n        <div class=\"summary-grid\">\n            <article><strong>${chapters.length}</strong><span>chapitre${chapters.length > 1 ? 's' : ''}</span></article>\n            <article><strong>${totalWords.toLocaleString('fr-FR')}</strong><span>mots</span></article>\n            <article><strong>${totalDialogues.toLocaleString('fr-FR')}</strong><span>paragraphes de dialogue</span></article>\n        </div>\n        <div class=\"result-title\">\n            <h2>Dialogues par chapitre</h2>\n            <span>${rows.length} résultat${rows.length > 1 ? 's' : ''}</span>\n        </div>\n        <div class=\"dialogue-list\">${cards}</div>\n        <p class=\"footnote\">Lecture seule : cette extension ne modifie aucun chapitre.</p>\n    `;\n\n    ecrivain.notify(`Analyse terminée : ${chapters.length} chapitre${chapters.length > 1 ? 's' : ''}.`);\n});\n",
  "style": ".plugin-title{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #e4d8c9}.plugin-title span{font-size:9px;letter-spacing:.12em;color:#9a7e60;font-weight:700}.plugin-title h1{margin:3px 0 0;font-size:24px}.analysis-loading,.analysis-empty{display:grid;gap:5px;padding:18px;border:1px dashed #c9b496;border-radius:10px;background:#fffaf2;color:#5b4c3e}.analysis-loading span,.analysis-empty p{margin:0;color:#7b6b5d;font-size:12px}.summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:18px}.summary-grid article{display:grid;gap:2px;padding:12px;border:1px solid #e2d5c5;border-radius:10px;background:#fffdf9;text-align:center}.summary-grid strong{font-size:22px;color:#3d3127}.summary-grid span{font-size:10px;color:#887666}.result-title{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:9px}.result-title h2{margin:0;font-size:17px}.result-title span{font-size:10px;color:#8b7968}.dialogue-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.dialogue-card{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid #e5dbcf;border-radius:9px;background:#fff}.dialogue-card__identity{min-width:0;display:grid;gap:3px}.dialogue-card__identity strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#44382e}.dialogue-card__identity small{color:#8b7d70;font-size:9px}.dialogue-card__count{flex:0 0 auto;display:grid;text-align:right}.dialogue-card__count strong{font-size:18px;color:#8a5d34}.dialogue-card__count span{font-size:8px;color:#98887a}.footnote{margin:14px 0 0;color:#8b7d70;font-size:9px}@media(max-width:720px){.summary-grid,.dialogue-list{grid-template-columns:1fr}}\n"
}
