{
  "format": "ecrivain-plugin",
  "packageVersion": 1,
  "manifest": {
    "id": "repetitions-tics",
    "name": "Répétitions et tics d’écriture",
    "version": "1.0.0",
    "author": "Écrivain",
    "description": "Repère les mots répétés à courte distance, les adverbes en « -ment » et les verbes ternes trop fréquents, les débuts de phrases identiques et les mots surreprésentés dans un chapitre. Ne corrige que les mots doublés (« de de »), après un clic.",
    "icon": "🔁",
    "ecrivainApi": 3,
    "permissions": [
      "project.read",
      "chapters.read",
      "chapters.write",
      "storage.read",
      "storage.write"
    ],
    "commands": [
      {
        "id": "lancer-analyse",
        "label": "Chercher répétitions et tics"
      }
    ]
  },
  "code": "/*\n * Répétitions et tics d'écriture — extension Écrivain (API v3).\n *\n * Compte et repère, sans jamais réécrire à votre place : mots répétés à courte\n * distance, adverbes en « -ment », verbes ternes (être, avoir, faire), débuts de\n * phrases identiques, mots surreprésentés dans un chapitre. Une seule correction\n * est proposée (un mot doublé : « de de »), et seulement après un clic.\n *\n * L'analyse est volontairement approximative : pas de lemmatisation (seul le\n * pluriel est rapproché du singulier) et une liste de mots outils codée en dur.\n */\n'use strict';\n\nconst NBSP = ' ';\n\n/** Espaces insécables avant la ponctuation haute dans les textes de l'interface. */\nfunction fr(text) {\n    return String(text)\n        .replace(/ ([:;?!»])/g, `${NBSP}$1`)\n        .replace(/« /g, `«${NBSP}`);\n}\n\nconst NAMED_ENTITIES = {\n    nbsp: NBSP, amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\",\n    laquo: '«', raquo: '»', hellip: '…', mdash: '—', ndash: '–',\n    rsquo: '’', lsquo: '‘', rdquo: '”', ldquo: '“', eacute: 'é', egrave: 'è',\n    agrave: 'à', ecirc: 'ê', ccedil: 'ç', oelig: 'œ', euro: '€', thinsp: ' ',\n    ensp: ' ', emsp: ' '\n};\n\nfunction decodeEntities(value) {\n    return String(value || '').replace(/&(#x[0-9a-f]+|#\\d+|[a-z][a-z0-9]*);/gi, (match, body) => {\n        if (body[0] === '#') {\n            const code = body[1] === 'x' || body[1] === 'X' ? parseInt(body.slice(2), 16) : parseInt(body.slice(1), 10);\n            if (!Number.isFinite(code) || code <= 0 || code > 0x10FFFF) return match;\n            try { return String.fromCodePoint(code); } catch (_) { return match; }\n        }\n        const named = NAMED_ENTITIES[body.toLowerCase()];\n        return named === undefined ? match : named;\n    });\n}\n\n// ---------------------------------------------------------------------------\n// Aplatissement du HTML : mêmes règles qu'Écrivain, pour que les positions et\n// les passages cités soient retrouvés à l'identique par applyCorrection.\n// ---------------------------------------------------------------------------\n\nconst BLOCK_TAG = /^(?:<\\/?(?:p|div|blockquote|h[1-6]|li|ul|ol)\\b|<br\\b)/i;\nconst BLOCK_OPEN = /^<(p|div|blockquote|h[1-6]|li)\\b/i;\nconst BLOCK_CLOSE = /^<\\/(p|div|blockquote|h[1-6]|li|ul|ol)\\b/i;\n\nfunction buildModel(html) {\n    const tokens = String(html || '<p></p>').match(/<!--[\\s\\S]*?-->|<[^>]+>|[^<]+/g) || [];\n    let flat = '';\n    const paragraphs = [];\n    let current = null;\n    let nextKind = 'text';\n    for (const raw of tokens) {\n        if (raw.startsWith('<')) {\n            if (BLOCK_TAG.test(raw) && flat && !flat.endsWith('\\n')) flat += '\\n';\n            if (/^<br\\b/i.test(raw)) continue;\n            if (BLOCK_OPEN.test(raw) || BLOCK_CLOSE.test(raw)) {\n                current = null;\n                const open = raw.match(BLOCK_OPEN);\n                if (open) nextKind = /^h[1-6]$/i.test(open[1]) ? 'heading' : 'text';\n            }\n            continue;\n        }\n        const decoded = decodeEntities(raw).normalize('NFC');\n        const entry = { decoded, flatStart: flat.length };\n        flat += decoded;\n        if (!current) {\n            current = { kind: nextKind, tokens: [] };\n            paragraphs.push(current);\n            nextKind = 'text';\n        }\n        current.tokens.push(entry);\n    }\n    return { flat, paragraphs };\n}\n\n// ---------------------------------------------------------------------------\n// Vocabulaire\n// ---------------------------------------------------------------------------\n\nconst DEFAULT_OPTIONS = {\n    disabled: {},\n    ignoredWords: [],\n    windowWords: 30,\n    adverbsPer1000: 8,\n    dullPer1000: 110,\n    startRun: 3,\n    overRatio: 4\n};\nconst FIX_LIMIT = 30;\nconst MIN_WORDS_STATS = 150;\n\nconst RULES = [\n    { id: 'repetition', category: 'repetitions', label: 'Mot répété de près', help: 'Un même mot (hors mots outils) revient à quelques mots d’écart.' },\n    { id: 'mot-double', category: 'repetitions', label: 'Mot doublé', help: 'Le même mot deux fois de suite (« de de »). Corrigeable en un clic pour les petits mots.' },\n    { id: 'adverbes', category: 'tics', label: 'Adverbes en -ment trop fréquents', help: 'Densité d’adverbes en « -ment » pour 1 000 mots.' },\n    { id: 'adverbes-proches', category: 'tics', label: 'Adverbes en -ment rapprochés', help: 'Deux adverbes en « -ment » ou plus à quelques mots d’écart.' },\n    { id: 'verbes-ternes', category: 'tics', label: 'Verbes ternes trop fréquents', help: 'Densité des formes d’être, avoir et faire pour 1 000 mots (auxiliaires compris).' },\n    { id: 'phrase-terne', category: 'tics', label: 'Phrase chargée en verbes ternes', help: 'Une phrase qui contient trois formes d’être, avoir ou faire, ou plus.' },\n    { id: 'debuts', category: 'debuts', label: 'Débuts de phrases identiques', help: 'Plusieurs phrases de suite qui commencent par le même mot.' },\n    { id: 'surrepresente', category: 'mots', label: 'Mot surreprésenté', help: 'Un mot beaucoup plus fréquent dans ce chapitre que dans le reste du livre.' }\n];\nconst RULE_BY_ID = Object.fromEntries(RULES.map((rule) => [rule.id, rule]));\n\nconst CATEGORY_LABELS = {\n    repetitions: 'Répétitions',\n    tics: 'Tics',\n    debuts: 'Débuts de phrases',\n    mots: 'Mots du chapitre'\n};\n\nconst SEVERITY_LABEL = { attention: 'Attention', info: 'Info' };\n\nfunction strip(word) {\n    return String(word).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\n}\n\n/** Rapproche le pluriel du singulier, rien de plus. */\nfunction stemOf(word) {\n    const base = strip(word);\n    return base.length > 4 && /[sx]$/.test(base) ? base.slice(0, -1) : base;\n}\n\nconst STOPWORDS = new Set(`\nalors apres assez aucun aucune aupres auquel aussi autant autre autres avant avec beaucoup bien\ncela celle celles celui cependant certain certaine certaines certains ceux chacun chaque chez comme comment\ncontre dans depuis dernier derniere donc dont elle elles encore enfin entre etait etaient etant\njamais jusque lequel lesquelles lesquels lors lorsque maintenant mais meme memes moins mon notre nous\nparce parmi pendant plus plusieurs puis puisque quand quel quelle quelles quelque quelques quels quoi\nrien sans selon sera seront sinon soit son sous sur tant tellement tels tres trop toujours tous tout toute toutes\nvers voici voila votre vous leur leurs cette ceci cet dit dire dis disait ici deja alors ainsi\nafin car ces mes tes ses nos vos\n`.split(/\\s+/).filter(Boolean));\n\nconst DULL_FORMS = new Set(`\nêtre suis es est sommes êtes sont étais était étions étiez étaient fus fut fûmes fûtes furent serai seras sera serons serez seront\nserais serait serions seriez seraient sois soit soyons soyez soient fusse fût étant\navoir ai as a avons avez ont avais avait avions aviez avaient eus eut eûmes eûtes eurent aurai auras aura aurons aurez auront\naurais aurait aurions auriez auraient aie aies ait ayons ayez aient eu ayant\nfaire fais fait faisons faites font faisais faisait faisions faisiez faisaient fis fit fîmes fîtes firent ferai feras fera ferons\nferez feront ferais ferait ferions feriez feraient fasse fasses fassions fassiez fassent faisant\n`.split(/\\s+/).filter(Boolean));\n\nconst NOT_ADVERBS = new Set(`\nmoment mouvement sentiment vetement document gouvernement appartement instrument batiment monument element argument\nciment aliment logement changement commencement tremblement battement rassemblement retournement regroupement\nreglement jugement tourment fragment segment ornement tempérament temperament emplacement deplacement remplacement\nenseignement renseignement engagement arrangement management testament complement supplement monument ferment\nserment sacrement parlement firmament testament amendement vêtement equipement revetement revêtement traitement\nmariage paiement payement remerciement acharnement emportement etonnement étonnement ebranlement ébranlement\ndetachement détachement attachement soulagement soulevement soulèvement tournement bourdonnement hurlement gémissement gemissement\nfrémissement fremissement craquement claquement grincement murmure raisonnement attentement comment\n`.split(/\\s+/).filter(Boolean).map(strip));\n\nconst DOUBLE_FIXABLE = new Set(`\nde la le les un une des et que qui dans pour sur au aux ce se ne mais ou par avec son sa ses mon ma mes ton ta tes notre votre\n`.split(/\\s+/).filter(Boolean));\n\n// ---------------------------------------------------------------------------\n// Découpage en mots et en phrases\n// ---------------------------------------------------------------------------\n\nfunction extractWords(model) {\n    const words = [];\n    for (let p = 0; p < model.paragraphs.length; p += 1) {\n        const paragraph = model.paragraphs[p];\n        if (paragraph.kind === 'heading') continue;\n        for (const token of paragraph.tokens) {\n            const re = /\\p{L}+/gu;\n            let match;\n            while ((match = re.exec(token.decoded)) !== null) {\n                const start = token.flatStart + match.index;\n                words.push({\n                    raw: match[0],\n                    lower: match[0].toLowerCase(),\n                    start,\n                    end: start + match[0].length,\n                    par: p,\n                    index: words.length,\n                    tokenStart: token.flatStart,\n                    tokenEnd: token.flatStart + token.decoded.length\n                });\n            }\n        }\n    }\n    return words;\n}\n\n/** Associe à chaque mot le numéro de sa phrase ; une phrase finit à . ! ? … ou à un changement de paragraphe. */\nfunction assignSentences(words, flat) {\n    let sentence = 0;\n    for (let i = 0; i < words.length; i += 1) {\n        if (i > 0) {\n            const gap = flat.slice(words[i - 1].end, words[i].start);\n            if (words[i].par !== words[i - 1].par || /[.!?…\\n]/.test(gap)) sentence += 1;\n        }\n        words[i].sentence = sentence;\n    }\n    return sentence + 1;\n}\n\nfunction isContentWord(word, lowercaseSeen) {\n    if (word.raw.length < 4) return false;\n    const base = strip(word.raw);\n    if (STOPWORDS.has(base) || DULL_FORMS.has(word.lower)) return false;\n    if (word.raw[0] !== word.lower[0] && !lowercaseSeen.has(word.lower)) return false;\n    return true;\n}\n\nfunction isAdverb(word) {\n    const base = strip(word.raw);\n    return base.length >= 7 && base.endsWith('ment') && !NOT_ADVERBS.has(base);\n}\n\n// ---------------------------------------------------------------------------\n// Analyse\n// ---------------------------------------------------------------------------\n\nfunction makeIssue(chapter, flat, rule, spec) {\n    const severity = spec.severity || 'info';\n    let excerpt = null;\n    if (spec.marks && spec.marks.length) {\n        const first = Math.min(...spec.marks.map((mark) => mark[0]));\n        const last = Math.max(...spec.marks.map((mark) => mark[1]));\n        const from = Math.max(0, first - 40);\n        const to = Math.min(flat.length, Math.max(last + 40, Math.min(last + 40, from + 300)));\n        const cut = Math.min(to, from + 320);\n        excerpt = {\n            text: flat.slice(from, cut),\n            marks: spec.marks\n                .map((mark) => [mark[0] - from, mark[1] - from])\n                .filter((mark) => mark[0] >= 0 && mark[1] <= cut - from),\n            before: from > 0,\n            after: cut < flat.length\n        };\n    }\n    const keyPart = spec.keyPart !== undefined\n        ? spec.keyPart\n        : (spec.marks && spec.marks.length ? flat.slice(Math.max(0, spec.marks[0][0] - 25), spec.marks[0][1] + 25) : '');\n    return {\n        rule,\n        category: RULE_BY_ID[rule].category,\n        severity,\n        message: spec.message,\n        chapterId: chapter.id,\n        chapterTitle: chapter.title || '',\n        excerpt,\n        word: spec.word || '',\n        fix: spec.fix || null,\n        key: [rule, chapter.id, spec.word || '', keyPart].join('|')\n    };\n}\n\nfunction topEntries(map, limit) {\n    return [...map.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'fr')).slice(0, limit);\n}\n\nfunction perThousand(count, total) {\n    return total ? Math.round((count * 10000) / total) / 10 : 0;\n}\n\n/** Vocabulaire des mots de fond de tout le livre : sert à repérer les mots surreprésentés. */\nfunction buildBookStats(chapters) {\n    const perChapter = new Map();\n    const total = new Map();\n    let totalWords = 0;\n    for (const chapter of chapters) {\n        if (chapter.status === 'cut') continue;\n        const model = buildModel(chapter.content);\n        const words = extractWords(model);\n        const lowercaseSeen = new Set(words.filter((word) => word.raw === word.lower).map((word) => word.lower));\n        const counts = new Map();\n        const forms = new Map();\n        for (const word of words) {\n            if (!isContentWord(word, lowercaseSeen)) continue;\n            const stem = stemOf(word.raw);\n            counts.set(stem, (counts.get(stem) || 0) + 1);\n            const seen = forms.get(stem) || new Map();\n            seen.set(word.lower, (seen.get(word.lower) || 0) + 1);\n            forms.set(stem, seen);\n            total.set(stem, (total.get(stem) || 0) + 1);\n        }\n        perChapter.set(chapter.id, { counts, forms, words: words.length });\n        totalWords += words.length;\n    }\n    return { perChapter, total, totalWords };\n}\n\nfunction fixFor(flat, start, target, replacement) {\n    if (!target || target === replacement || target.length > 450) return null;\n    return {\n        start,\n        end: start + target.length,\n        target,\n        replacement,\n        before: flat.slice(Math.max(0, start - 120), start),\n        after: flat.slice(start + target.length, start + target.length + 130),\n        ruleId: 'mot-double'\n    };\n}\n\n/**\n * Analyse un chapitre. Retourne { issues, metrics }.\n */\nfunction analyzeChapter(chapter, options, bookStats) {\n    const opts = { ...DEFAULT_OPTIONS, ...(options || {}) };\n    const enabled = (rule) => !(opts.disabled && opts.disabled[rule]);\n    const ignoredStems = new Set((opts.ignoredWords || []).map(stemOf));\n    const metrics = { words: 0, adverbsPer1000: 0, dullPer1000: 0, repetitions: 0, issues: 0 };\n    if (chapter.status === 'cut') return { issues: [], metrics };\n\n    const model = buildModel(chapter.content);\n    const flat = model.flat;\n    const words = extractWords(model);\n    metrics.words = words.length;\n    if (!words.length) return { issues: [], metrics };\n    assignSentences(words, flat);\n    const lowercaseSeen = new Set(words.filter((word) => word.raw === word.lower).map((word) => word.lower));\n    const issues = [];\n    const add = (rule, spec) => issues.push(makeIssue(chapter, flat, rule, spec));\n\n    // --- Mots doublés ------------------------------------------------------\n    if (enabled('mot-double')) {\n        let doubles = 0;\n        for (let i = 1; i < words.length && doubles < 60; i += 1) {\n            const prev = words[i - 1];\n            const cur = words[i];\n            if (prev.par !== cur.par || prev.lower !== cur.lower || cur.raw.length < 2) continue;\n            if (!/^[ ]$/.test(flat.slice(prev.end, cur.start))) continue;\n            if (['nous', 'vous', 'bien', 'tres', 'très', 'pas', 'tout', 'peu', 'ça', 'oui', 'non'].includes(cur.lower)) continue;\n            const sameToken = prev.tokenStart === cur.tokenStart;\n            const fixable = sameToken && DOUBLE_FIXABLE.has(cur.lower);\n            const target = flat.slice(prev.start, cur.end);\n            doubles += 1;\n            add('mot-double', {\n                severity: 'attention',\n                message: `« ${prev.raw} » est écrit deux fois de suite.`,\n                word: cur.lower,\n                marks: [[prev.start, prev.end], [cur.start, cur.end]],\n                fix: fixable ? fixFor(flat, prev.start, target, prev.raw) : null\n            });\n        }\n    }\n\n    // --- Mots répétés de près ----------------------------------------------\n    const occurrences = new Map();\n    for (const word of words) {\n        if (!isContentWord(word, lowercaseSeen)) continue;\n        const stem = stemOf(word.raw);\n        if (ignoredStems.has(stem)) continue;\n        const list = occurrences.get(stem) || [];\n        list.push(word);\n        occurrences.set(stem, list);\n    }\n    if (enabled('repetition')) {\n        const clusters = [];\n        for (const [stem, list] of occurrences) {\n            let chain = [list[0]];\n            const flush = () => {\n                if (chain.length >= 2) clusters.push({ stem, chain });\n                chain = [];\n            };\n            for (let i = 1; i < list.length; i += 1) {\n                if (list[i].index - chain[chain.length - 1].index <= opts.windowWords) chain.push(list[i]);\n                else { flush(); chain = [list[i]]; }\n            }\n            flush();\n        }\n        clusters.sort((a, b) => a.chain[0].start - b.chain[0].start);\n        metrics.repetitions = clusters.length;\n        for (const cluster of clusters.slice(0, 80)) {\n            const { chain } = cluster;\n            const span = chain[chain.length - 1].index - chain[0].index;\n            const close = chain.length === 2 && span <= 8;\n            const forms = [...new Set(chain.map((word) => word.lower))];\n            add('repetition', {\n                severity: chain.length >= 3 || close ? 'attention' : 'info',\n                message: `« ${forms.join(' / ')} » : ${chain.length} fois en ${span + 1} mots.`,\n                word: cluster.stem,\n                marks: chain.map((word) => [word.start, word.end])\n            });\n        }\n    }\n\n    // --- Adverbes en -ment ---------------------------------------------------\n    const adverbs = words.filter((word) => isAdverb(word) && !ignoredStems.has(stemOf(word.raw)));\n    metrics.adverbsPer1000 = perThousand(adverbs.length, words.length);\n    if (enabled('adverbes') && words.length >= MIN_WORDS_STATS && adverbs.length >= 4 && metrics.adverbsPer1000 > opts.adverbsPer1000) {\n        const counts = new Map();\n        for (const word of adverbs) counts.set(word.lower, (counts.get(word.lower) || 0) + 1);\n        const top = topEntries(counts, 6).map(([form, n]) => `${form} (${n})`).join(', ');\n        add('adverbes', {\n            severity: metrics.adverbsPer1000 > opts.adverbsPer1000 * 1.5 ? 'attention' : 'info',\n            message: `${adverbs.length} adverbes en « -ment », soit ${String(metrics.adverbsPer1000).replace('.', ',')} pour 1 000 mots (seuil : ${opts.adverbsPer1000}). Les plus fréquents : ${top}.`,\n            word: '-ment',\n            keyPart: ''\n        });\n    }\n    if (enabled('adverbes-proches')) {\n        let chain = [];\n        const clusters = [];\n        const flush = () => { if (chain.length >= 2) clusters.push(chain); chain = []; };\n        for (const word of adverbs) {\n            if (chain.length && word.index - chain[chain.length - 1].index > 12) flush();\n            chain.push(word);\n        }\n        flush();\n        for (const cluster of clusters.slice(0, 40)) {\n            add('adverbes-proches', {\n                severity: 'info',\n                message: `${cluster.length} adverbes en « -ment » à quelques mots d’écart.`,\n                word: cluster.map((word) => word.lower).join('+'),\n                marks: cluster.map((word) => [word.start, word.end])\n            });\n        }\n    }\n\n    // --- Verbes ternes -------------------------------------------------------\n    const dull = words.filter((word) => DULL_FORMS.has(word.lower));\n    metrics.dullPer1000 = perThousand(dull.length, words.length);\n    if (enabled('verbes-ternes') && words.length >= MIN_WORDS_STATS && metrics.dullPer1000 > opts.dullPer1000) {\n        const counts = new Map();\n        for (const word of dull) counts.set(word.lower, (counts.get(word.lower) || 0) + 1);\n        const top = topEntries(counts, 6).map(([form, n]) => `${form} (${n})`).join(', ');\n        add('verbes-ternes', {\n            severity: metrics.dullPer1000 > opts.dullPer1000 * 1.3 ? 'attention' : 'info',\n            message: `${dull.length} formes d’être, avoir ou faire, soit ${String(metrics.dullPer1000).replace('.', ',')} pour 1 000 mots (seuil : ${opts.dullPer1000}). Les plus fréquentes : ${top}.`,\n            word: 'ternes',\n            keyPart: ''\n        });\n    }\n    if (enabled('phrase-terne')) {\n        const bySentence = new Map();\n        for (const word of dull) {\n            const list = bySentence.get(word.sentence) || [];\n            list.push(word);\n            bySentence.set(word.sentence, list);\n        }\n        let shown = 0;\n        for (const list of bySentence.values()) {\n            if (list.length < 3 || shown >= 40) continue;\n            shown += 1;\n            add('phrase-terne', {\n                severity: 'info',\n                message: `${list.length} formes d’être, avoir ou faire dans la même phrase.`,\n                word: 'phrase',\n                marks: list.map((word) => [word.start, word.end])\n            });\n        }\n    }\n\n    // --- Débuts de phrases identiques ----------------------------------------\n    if (enabled('debuts')) {\n        const starts = [];\n        for (const word of words) {\n            if (!starts.length || starts[starts.length - 1].sentence !== word.sentence) starts.push(word);\n        }\n        let i = 0;\n        let shown = 0;\n        while (i < starts.length) {\n            let j = i + 1;\n            while (j < starts.length && starts[j].lower === starts[i].lower) j += 1;\n            const run = j - i;\n            if (run >= opts.startRun && shown < 40) {\n                shown += 1;\n                const label = starts[i].raw;\n                add('debuts', {\n                    severity: run >= opts.startRun + 1 ? 'attention' : 'info',\n                    message: `${run} phrases de suite commencent par « ${label} ».`,\n                    word: starts[i].lower,\n                    marks: starts.slice(i, j).slice(0, 6).map((word) => [word.start, word.end])\n                });\n            }\n            i = j;\n        }\n    }\n\n    // --- Mots surreprésentés --------------------------------------------------\n    const mine = bookStats && bookStats.perChapter.get(chapter.id);\n    if (enabled('surrepresente') && mine && words.length >= 250 && bookStats.totalWords - mine.words >= 500) {\n        const restWords = bookStats.totalWords - mine.words;\n        const found = [];\n        for (const [stem, count] of mine.counts) {\n            if (count < 5 || ignoredStems.has(stem)) continue;\n            const forms = mine.forms.get(stem);\n            const lowercaseCount = [...forms.entries()].filter(([form]) => form === form.toLowerCase()).reduce((sum, [, n]) => sum + n, 0);\n            if (lowercaseCount < count * 0.7) continue;\n            const density = (count * 1000) / mine.words;\n            const rest = ((bookStats.total.get(stem) || 0) - count) * 1000 / restWords;\n            const ratio = density / Math.max(rest, 0.5);\n            if (ratio >= opts.overRatio) found.push({ stem, count, density, rest, ratio, form: topEntries(forms, 1)[0][0] });\n        }\n        found.sort((a, b) => b.ratio - a.ratio || b.count - a.count);\n        for (const item of found.slice(0, 8)) {\n            add('surrepresente', {\n                severity: 'info',\n                message: `« ${item.form} » : ${item.count} fois dans ce chapitre (${Math.round(item.density * 10) / 10} pour 1 000 mots), contre ${Math.round(item.rest * 10) / 10} dans le reste du livre.`.replace(/(\\d)\\.(\\d)/g, '$1,$2'),\n                word: item.stem,\n                keyPart: ''\n            });\n        }\n    }\n\n    metrics.issues = issues.length;\n    return { issues, metrics };\n}\n\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = { buildModel, analyzeChapter, buildBookStats, extractWords, stemOf, isAdverb, RULES, DEFAULT_OPTIONS, fr, FIX_LIMIT, DULL_FORMS, STOPWORDS };\n}\n\nif (typeof ecrivain !== 'undefined') {\n    (function ui() {\n        const state = {\n            project: null,\n            chapters: [],\n            bookStats: null,\n            issues: [],\n            metrics: new Map(),\n            options: { ...DEFAULT_OPTIONS, disabled: {}, ignoredWords: [] },\n            ignored: new Set(),\n            filter: 'all',\n            showIgnored: false,\n            expanded: new Set(),\n            busy: false,\n            message: ''\n        };\n\n        const esc = (value) => String(value ?? '')\n            .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')\n            .replaceAll('\"', '&quot;').replaceAll(\"'\", '&#039;');\n        const plural = (n, one, many) => (n > 1 ? many : one);\n        const num = (n) => String(n).replace('.', ',');\n\n        function visible(text) {\n            return esc(text).replaceAll('\\n', '<span class=\"nl\" title=\"saut de ligne\">⏎</span> ');\n        }\n\n        function excerptHtml(excerpt) {\n            let html = excerpt.before ? '…' : '';\n            let cursor = 0;\n            for (const [from, to] of [...excerpt.marks].sort((a, b) => a[0] - b[0])) {\n                if (from < cursor) continue;\n                html += `${visible(excerpt.text.slice(cursor, from))}<mark>${visible(excerpt.text.slice(from, to))}</mark>`;\n                cursor = to;\n            }\n            html += visible(excerpt.text.slice(cursor));\n            return `<p class=\"excerpt\">${html}${excerpt.after ? '…' : ''}</p>`;\n        }\n\n        async function loadSettings() {\n            try {\n                const saved = await ecrivain.storage.read();\n                if (saved && typeof saved === 'object') {\n                    const options = saved.options || {};\n                    state.options = {\n                        ...DEFAULT_OPTIONS,\n                        ...options,\n                        disabled: { ...(options.disabled || {}) },\n                        ignoredWords: Array.isArray(options.ignoredWords) ? options.ignoredWords.slice(0, 300) : []\n                    };\n                    state.ignored = new Set(Array.isArray(saved.ignored) ? saved.ignored.slice(-1500) : []);\n                }\n            } catch (_) { /* première utilisation */ }\n        }\n\n        async function saveSettings() {\n            try {\n                await ecrivain.storage.write({\n                    version: 1,\n                    options: state.options,\n                    ignored: [...state.ignored].slice(-1500)\n                });\n            } catch (error) {\n                state.message = `Réglages non enregistrés : ${error.message || error}`;\n            }\n        }\n\n        function analyzeAll() {\n            state.bookStats = buildBookStats(state.chapters);\n            state.issues = [];\n            state.metrics = new Map();\n            for (const chapter of state.chapters) {\n                const result = analyzeChapter(chapter, state.options, state.bookStats);\n                state.issues.push(...result.issues);\n                state.metrics.set(chapter.id, result.metrics);\n            }\n        }\n\n        const chapterById = (id) => state.chapters.find((chapter) => chapter.id === id);\n        const isShown = (issue) => state.showIgnored || !state.ignored.has(issue.key);\n\n        function matchesFilter(issue) {\n            if (state.filter === 'all') return true;\n            if (state.filter === 'fix') return Boolean(issue.fix);\n            return issue.category === state.filter;\n        }\n\n        function counts() {\n            const live = state.issues.filter((issue) => !state.ignored.has(issue.key));\n            const by = (category) => live.filter((issue) => issue.category === category).length;\n            return {\n                total: live.length,\n                ignored: state.issues.length - live.length,\n                fixable: live.filter((issue) => issue.fix).length,\n                repetitions: by('repetitions'),\n                tics: by('tics'),\n                debuts: by('debuts'),\n                mots: by('mots'),\n                words: [...state.metrics.values()].reduce((sum, m) => sum + m.words, 0)\n            };\n        }\n\n        function renderIssue(issue, index) {\n            const rule = RULE_BY_ID[issue.rule];\n            const ignored = state.ignored.has(issue.key);\n            const wordButton = issue.word && ['repetition', 'surrepresente'].includes(issue.rule)\n                ? `<button type=\"button\" data-action=\"skip-word\" data-index=\"${index}\">Ne plus signaler ce mot</button>` : '';\n            const fix = issue.fix\n                ? `<button type=\"button\" class=\"primary\" data-action=\"fix\" data-index=\"${index}\" ${state.busy ? 'disabled' : ''}>Corriger</button>` : '';\n            const ignore = ignored\n                ? `<button type=\"button\" data-action=\"unignore\" data-index=\"${index}\">Ne plus ignorer</button>`\n                : `<button type=\"button\" data-action=\"ignore\" data-index=\"${index}\">Ignorer</button>`;\n            return `<li class=\"issue sev-${issue.severity}${ignored ? ' is-ignored' : ''}\">\n                <div class=\"issue-head\">\n                    <span class=\"badge sev-${issue.severity}\">${SEVERITY_LABEL[issue.severity]}</span>\n                    <strong>${esc(rule.label)}</strong>\n                </div>\n                <p>${esc(issue.message)}</p>\n                ${issue.excerpt ? excerptHtml(issue.excerpt) : ''}\n                <div class=\"issue-actions\">${fix}${wordButton}${ignore}</div>\n            </li>`;\n        }\n\n        function render() {\n            const root = document.getElementById('plugin-root');\n            const c = counts();\n            const filterButton = (id, label, n) => `<button type=\"button\" class=\"filter${state.filter === id ? ' is-active' : ''}\" data-action=\"filter\" data-filter=\"${id}\">${esc(fr(label))} <span>${n}</span></button>`;\n            const rulesHtml = RULES.map((rule) => `\n                <label class=\"rule\" title=\"${esc(rule.help)}\">\n                    <input type=\"checkbox\" data-rule=\"${rule.id}\" ${state.options.disabled[rule.id] ? '' : 'checked'}>\n                    ${esc(rule.label)}\n                </label>`).join('');\n            const numberOption = (key, label, min, max, step) => `<label class=\"min-words\">${esc(fr(label))} <input type=\"number\" min=\"${min}\" max=\"${max}\" step=\"${step}\" data-option=\"${key}\" value=\"${Number(state.options[key])}\"></label>`;\n            const wordChips = state.options.ignoredWords.length\n                ? `<p class=\"chips\"><span>Mots ignorés :</span> ${state.options.ignoredWords.map((word) => `<button type=\"button\" class=\"chip\" data-action=\"unword\" data-word=\"${esc(word)}\" title=\"Signaler de nouveau ce mot\">${esc(word)} ×</button>`).join(' ')}</p>`\n                : '';\n\n            let groups = '';\n            for (const chapter of state.chapters) {\n                const chapterIssues = state.issues.filter((issue) => issue.chapterId === chapter.id && isShown(issue) && matchesFilter(issue));\n                if (!chapterIssues.length) continue;\n                const fixCount = chapterIssues.filter((issue) => issue.fix && !state.ignored.has(issue.key)).length;\n                const expanded = state.expanded.has(chapter.id);\n                const shown = expanded ? chapterIssues : chapterIssues.slice(0, 40);\n                const hidden = chapterIssues.length - shown.length;\n                const m = state.metrics.get(chapter.id) ||