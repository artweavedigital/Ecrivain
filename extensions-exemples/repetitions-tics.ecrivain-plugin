     <div>\n                        <span>RÉPÉTITIONS ET TICS</span>\n                        <h1>${esc(state.project?.title || 'Manuscrit')}</h1>\n                    </div>\n                    <button type=\"button\" data-action=\"rerun\" ${state.busy ? 'disabled' : ''}>Relancer l’analyse</button>\n                </header>\n                ${state.message ? `<p class=\"notice\">${esc(state.message)}</p>` : ''}\n                <div class=\"summary-grid\">\n                    <article><strong>${c.words.toLocaleString('fr-FR')}</strong><span>mots lus</span></article>\n                    <article><strong>${c.repetitions}</strong><span>${plural(c.repetitions, 'répétition', 'répétitions')}</span></article>\n                    <article><strong>${c.tics}</strong><span>${plural(c.tics, 'tic', 'tics')}</span></article>\n                    <article><strong>${c.debuts}</strong><span>${plural(c.debuts, 'début identique', 'débuts identiques')}</span></article>\n                    <article><strong>${c.mots}</strong><span>${plural(c.mots, 'mot surreprésenté', 'mots surreprésentés')}</span></article>\n                </div>\n                <details class=\"options\">\n                    <summary>Règles et seuils</summary>\n                    <div class=\"rules\">${rulesHtml}</div>\n                    ${numberOption('windowWords', 'Répétition : distance maximale, en mots :', 5, 200, 5)}\n                    ${numberOption('adverbsPer1000', 'Adverbes en -ment : seuil pour 1 000 mots :', 1, 100, 1)}\n                    ${numberOption('dullPer1000', 'Verbes ternes : seuil pour 1 000 mots :', 20, 300, 5)}\n                    ${numberOption('startRun', 'Débuts identiques : à partir de combien de phrases :', 2, 10, 1)}\n                    ${numberOption('overRatio', 'Mot surreprésenté : rapport minimal avec le reste du livre :', 2, 20, 1)}\n                    ${wordChips}\n                </details>\n                <details class=\"options\">\n                    <summary>Chiffres par chapitre</summary>\n                    <table class=\"metrics\"><thead><tr><th>Chapitre</th><th>Mots</th><th>-ment / 1 000</th><th>Ternes / 1 000</th><th>Répétitions</th></tr></thead><tbody>${rows}</tbody></table>\n                </details>\n                <div class=\"filters\">\n                    ${filterButton('all', 'Tout', c.total + (state.showIgnored ? c.ignored : 0))}\n                    ${filterButton('fix', 'Corrigeables en un clic', c.fixable)}\n                    ${filterButton('repetitions', 'Répétitions', c.repetitions)}\n                    ${filterButton('tics', 'Tics', c.tics)}\n                    ${filterButton('debuts', 'Débuts de phrases', c.debuts)}\n                    ${filterButton('mots', 'Mots surreprésentés', c.mots)}\n                    ${c.ignored ? `<button type=\"button\" class=\"filter${state.showIgnored ? ' is-active' : ''}\" data-action=\"toggle-ignored\">Ignorés <span>${c.ignored}</span></button>` : ''}\n                </div>\n                ${groups}\n                <p class=\"footnote\">${esc(fr('Analyse approximative : seuls les pluriels sont rapprochés des singuliers, et les auxiliaires comptent parmi les verbes ternes. Un mot répété peut être voulu (rythme, refrain) : à vous de juger. Les mots surreprésentés demandent au moins deux chapitres. Les corrections passent par l’historique du chapitre.'))}</p>`;\n        }\n\n        async function refreshChapter(chapterId) {\n            const fresh = await ecrivain.chapters.get(chapterId);\n            const old = chapterById(chapterId) || {};\n            const index = state.chapters.findIndex((chapter) => chapter.id === chapterId);\n            const merged = { ...old, ...fresh, depth: old.depth || 0 };\n            if (index >= 0) state.chapters[index] = merged;\n            return merged;\n        }\n\n        function reanalyzeChapter(chapterId) {\n            state.bookStats = buildBookStats(state.chapters);\n            const chapter = chapterById(chapterId);\n            state.issues = state.issues.filter((issue) => issue.chapterId !== chapterId);\n            if (chapter) {\n                const result = analyzeChapter(chapter, state.options, state.bookStats);\n                state.issues.push(...result.issues);\n                state.metrics.set(chapterId, result.metrics);\n            }\n            const order = new Map(state.chapters.map((c, i) => [c.id, i]));\n            state.issues.sort((a, b) => order.get(a.chapterId) - order.get(b.chapterId));\n        }\n\n        async function fixOne(issue) {\n            if (!issue.fix) return;\n            state.busy = true;\n            state.message = '';\n            try {\n                const result = await ecrivain.chapters.applyCorrection(issue.chapterId, issue.fix);\n                if (!result || !result.applied) throw new Error('La correction n’a pas pu être appliquée.');\n                await refreshChapter(issue.chapterId);\n                reanalyzeChapter(issue.chapterId);\n                ecrivain.notify('Correction appliquée.');\n            } catch (error) {\n                state.message = fr(`Correction refusée : ${error.message || error} Corrigez ce passage directement dans le manuscrit.`);\n            } finally {\n                state.busy = false;\n                render();\n            }\n        }\n\n        async function fixChapter(chapterId) {\n            state.busy = true;\n            state.message = '';\n            render();\n            let applied = 0;\n            try {\n                for (let i = 0; i < FIX_LIMIT; i += 1) {\n                    const chapter = await refreshChapter(chapterId);\n                    const next = analyzeChapter(chapter, state.options, state.bookStats).issues\n                        .find((issue) => issue.fix && !state.ignored.has(issue.key));\n                    if (!next) break;\n                    const result = await ecrivain.chapters.applyCorrection(chapterId, next.fix);\n                    if (!result || !result.applied) throw new Error('une correction n’a pas pu être appliquée.');\n                    applied += 1;\n                }\n                state.message = fr(`${applied} correction${applied > 1 ? 's' : ''} appliquée${applied > 1 ? 's' : ''}${applied >= FIX_LIMIT ? ` (limite de ${FIX_LIMIT} par clic : relancez pour la suite)` : ''}.`);\n                ecrivain.notify(`${applied} correction${applied > 1 ? 's' : ''} appliquée${applied > 1 ? 's' : ''}.`);\n            } catch (error) {\n                state.message = fr(`Arrêt après ${applied} correction${applied > 1 ? 's' : ''} : ${error.message || error}`);\n            } finally {\n                try { await refreshChapter(chapterId); } catch (_) { /* affichage seulement */ }\n                reanalyzeChapter(chapterId);\n                state.busy = false;\n                render();\n            }\n        }\n\n        async function run() {\n            const root = document.getElementById('plugin-root');\n            root.innerHTML = '<div class=\"analysis-loading\"><strong>Lecture du projet…</strong><span>Écrivain rassemble les chapitres et leur contenu.</span></div>';\n            await loadSettings();\n            state.project = await ecrivain.project.getCurrent();\n            state.chapters = await ecrivain.chapters.readAll();\n            state.message = '';\n            if (!state.chapters.length) {\n                root.innerHTML = '<div class=\"all-clear\"><strong>Aucun chapitre à analyser.</strong><p>Créez au moins un chapitre dans le projet, puis relancez l’analyse.</p></div>';\n                return;\n            }\n            analyzeAll();\n            render();\n            const c = counts();\n            ecrivain.notify(c.total ? `Analyse terminée : ${c.total} résultat${c.total > 1 ? 's' : ''}.` : 'Analyse terminée : rien à signaler.');\n        }\n\n        async function changeWords(mutate) {\n            mutate(state.options.ignoredWords);\n            await saveSettings();\n            analyzeAll();\n            render();\n        }\n\n        const root = document.getElementById('plugin-root');\n        root.addEventListener('click', async (event) => {\n            const button = event.target.closest('[data-action]');\n            if (!button || button.disabled) return;\n            const action = button.dataset.action;\n            const issue = button.dataset.index !== undefined ? state.issues[Number(button.dataset.index)] : null;\n            if (action === 'rerun') { await run(); return; }\n            if (action === 'filter') { state.filter = button.dataset.filter; render(); return; }\n            if (action === 'toggle-ignored') { state.showIgnored = !state.showIgnored; render(); return; }\n            if (action === 'expand') { state.expanded.add(button.dataset.chapter); render(); return; }\n            if (action === 'ignore' && issue) { state.ignored.add(issue.key); await saveSettings(); render(); return; }\n            if (action === 'unignore' && issue) { state.ignored.delete(issue.key); await saveSettings(); render(); return; }\n            if (action === 'skip-word' && issue) {\n                await changeWords((list) => { if (!list.includes(issue.word) && list.length < 300) list.push(issue.word); });\n                return;\n            }\n            if (action === 'unword') {\n                await changeWords((list) => { const at = list.indexOf(button.dataset.word); if (at >= 0) list.splice(at, 1); });\n                return;\n            }\n            if (action === 'fix' && issue) { await fixOne(issue); return; }\n            if (action === 'fix-chapter') { await fixChapter(button.dataset.chapter); }\n        });\n        root.addEventListener('change', async (event) => {\n            const target = event.target;\n            if (target.dataset && target.dataset.rule) {\n                state.options.disabled[target.dataset.rule] = !target.checked;\n                await saveSettings();\n