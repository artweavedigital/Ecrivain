{
  "format": "ecrivain-plugin",
  "packageVersion": 1,
  "manifest": {
    "id": "controle-avant-export",
    "name": "Contrôle avant export",
    "version": "1.0.0",
    "author": "Écrivain",
    "description": "Repère avant l’export, et avant la mise en page dans XPress ou Scribus, ce qui gêne : guillemets droits, tirets de dialogue, caractères invisibles, retours à la ligne forcés, mises en forme imposées, images non exportées. Corrige en un clic ce qui est sans ambiguïté.",
    "icon": "✅",
    "ecrivainApi": 3,
    "permissions": [
      "project.read",
      "chapters.read",
      "chapters.write",
      "storage.read",
      "storage.write"
    ],
    "commands": [
      {
        "id": "lancer-controle",
        "label": "Lancer le contrôle avant export"
      }
    ]
  },
  "code": "/*\n * Contrôle avant export — extension Écrivain (API v3).\n *\n * Lit tous les chapitres, signale ce qui gêne à l'export ou à la mise en page\n * (XPress, Scribus, InDesign…) et propose des corrections sûres. Une correction\n * n'est jamais appliquée sans clic : elle passe par chapters.applyCorrection,\n * qu'Écrivain limite à un seul passage, situé dans un seul morceau de texte.\n *\n * Ce que l'export corrige déjà seul (apostrophes, points de suspension, espaces\n * avant « ; ? ! : », espaces ordinaires multiples) n'est pas signalé ici.\n */\n'use strict';\n\nconst NBSP = ' ';\nconst NNBSP = ' ';\n\n/** Espaces insécables avant la ponctuation haute dans les textes de l'interface. */\nfunction fr(text) {\n    return String(text)\n        .replace(/ ([:;?!»])/g, `${NBSP}$1`)\n        .replace(/« /g, `«${NBSP}`);\n}\n\n// ---------------------------------------------------------------------------\n// Décodage et aplatissement du HTML : mêmes règles qu'Écrivain, pour que les\n// positions et les passages cités soient retrouvés à l'identique.\n// ---------------------------------------------------------------------------\n\nconst NAMED_ENTITIES = {\n    nbsp: NBSP, amp: '&', lt: '<', gt: '>', quot: '\"', apos: \"'\",\n    laquo: '«', raquo: '»', hellip: '…', mdash: '—', ndash: '–',\n    rsquo: '’', lsquo: '‘', rdquo: '”', ldquo: '“', eacute: 'é', egrave: 'è',\n    agrave: 'à', ecirc: 'ê', ccedil: 'ç', oelig: 'œ', euro: '€', thinsp: ' ',\n    ensp: ' ', emsp: ' '\n};\n\nfunction decodeEntities(value) {\n    return String(value || '').replace(/&(#x[0-9a-f]+|#\\d+|[a-z][a-z0-9]*);/gi, (match, body) => {\n        if (body[0] === '#') {\n            const code = body[1] === 'x' || body[1] === 'X' ? parseInt(body.slice(2), 16) : parseInt(body.slice(1), 10);\n            if (!Number.isFinite(code) || code <= 0 || code > 0x10FFFF) return match;\n            try { return String.fromCodePoint(code); } catch (_) { return match; }\n        }\n        const named = NAMED_ENTITIES[body.toLowerCase()];\n        return named === undefined ? match : named;\n    });\n}\n\nconst BLOCK_TAG = /^(?:<\\/?(?:p|div|blockquote|h[1-6]|li|ul|ol)\\b|<br\\b)/i;\nconst BLOCK_OPEN = /^<(p|div|blockquote|h[1-6]|li)\\b/i;\nconst BLOCK_CLOSE = /^<\\/(p|div|blockquote|h[1-6]|li|ul|ol)\\b/i;\n\nfunction tagKind(name) {\n    const tag = String(name).toLowerCase();\n    if (tag === 'blockquote') return 'quote';\n    if (tag === 'li') return 'item';\n    if (/^h[1-6]$/.test(tag)) return 'heading';\n    return 'text';\n}\n\n/**\n * Découpe un chapitre en paragraphes de texte, avec la position de chaque morceau\n * de texte dans le texte aplati (celui qu'Écrivain utilise pour retrouver un passage).\n */\nfunction buildModel(html) {\n    const tokens = String(html || '<p></p>').match(/<!--[\\s\\S]*?-->|<[^>]+>|[^<]+/g) || [];\n    let flat = '';\n    const paragraphs = [];\n    const model = {\n        flat: '', paragraphs, softBreaks: [], images: 0, tables: 0,\n        headings: 0, quotes: 0, items: 0, emphasis: 0, strong: 0, superscript: 0, overrides: []\n    };\n    let current = null;\n    let nextKind = 'text';\n    let pendingBreak = false;\n    let pendingOverride = null;\n\n    for (const raw of tokens) {\n        if (raw.startsWith('<')) {\n            if (BLOCK_TAG.test(raw) && flat && !flat.endsWith('\\n')) flat += '\\n';\n            if (/^<br\\b/i.test(raw)) {\n                if (current && current.tokens.length) pendingBreak = true;\n                continue;\n            }\n            if (BLOCK_OPEN.test(raw) || BLOCK_CLOSE.test(raw)) {\n                current = null;\n                pendingBreak = false;\n                const open = raw.match(BLOCK_OPEN);\n                if (open) {\n                    nextKind = tagKind(open[1]);\n                    if (nextKind === 'heading') model.headings += 1;\n                    if (nextKind === 'quote') model.quotes += 1;\n                    if (nextKind === 'item') model.items += 1;\n                }\n                continue;\n            }\n            if (/^<img\\b/i.test(raw)) model.images += 1;\n            else if (/^<table\\b/i.test(raw)) model.tables += 1;\n            else if (/^<(i|em)\\b/i.test(raw)) model.emphasis += 1;\n            else if (/^<(b|strong)\\b/i.test(raw)) model.strong += 1;\n            else if (/^<sup\\b/i.test(raw)) model.superscript += 1;\n            const kinds = overrideKinds(raw);\n            if (kinds.length) pendingOverride = kinds;\n            continue;\n        }\n        const decoded = decodeEntities(raw).normalize('NFC');\n        const entry = { decoded, flatStart: flat.length };\n        flat += decoded;\n        if (!current) {\n            current = { kind: nextKind, tokens: [] };\n            paragraphs.push(current);\n            nextKind = 'text';\n        }\n        if (pendingBreak && decoded.trim()) {\n            model.softBreaks.push({ flatStart: entry.flatStart });\n            pendingBreak = false;\n        }\n        current.tokens.push(entry);\n        if (pendingOverride && decoded.trim()) {\n            model.overrides.push({ kinds: pendingOverride, flatStart: entry.flatStart, sample: decoded.trim().slice(0, 40) });\n            pendingOverride = null;\n        }\n    }\n    model.flat = flat;\n    return model;\n}\n\nfunction overrideKinds(tag) {\n    const kinds = [];\n    const style = (tag.match(/\\bstyle\\s*=\\s*\"([^\"]*)\"/i) || [])[1] || '';\n    if (/<font\\b/i.test(tag)) {\n        if (/\\bface\\s*=/i.test(tag)) kinds.push('police');\n        if (/\\bsize\\s*=/i.test(tag)) kinds.push('taille');\n        if (/\\bcolor\\s*=/i.test(tag)) kinds.push('couleur');\n    }\n    if (/(^|;)\\s*font-family\\s*:/i.test(style)) kinds.push('police');\n    if (/(^|;)\\s*font-size\\s*:/i.test(style)) kinds.push('taille');\n    if (/(^|;)\\s*color\\s*:/i.test(style)) kinds.push('couleur');\n    if (/(^|;)\\s*background(-color)?\\s*:/i.test(style) && !/background(-color)?\\s*:\\s*(transparent|none)/i.test(style)) kinds.push('surlignage');\n    return [...new Set(kinds)];\n}\n\n// ---------------------------------------------------------------------------\n// Règles\n// ---------------------------------------------------------------------------\n\nconst RULES = {\n    'guillemets-droits': {\n        label: 'Guillemets droits ou anglais', severity: 'attention',\n        help: 'Les guillemets \" \" ou “ ” ne sont pas convertis à l’export. Ils deviennent « … » avec espaces insécables.'\n    },\n    'tiret-dialogue': {\n        label: 'Tiret de dialogue', severity: 'attention',\n        help: 'Un dialogue commence par un tiret cadratin (—) suivi d’une espace, pas par un tiret court (-) ou demi-cadratin (–).'\n    },\n    'caracteres-invisibles': {\n        label: 'Caractères invisibles', severity: 'erreur',\n        help: 'Espaces de largeur nulle, traits d’union conditionnels, séparateurs de ligne : invisibles à l’écran, ils perturbent la mise en page.'\n    },\n    'espaces-melees': {\n        label: 'Espaces mêlées', severity: 'attention',\n        help: 'Une espace insécable accolée à une autre espace n’est pas réduite à l’export et laisse un blanc irrégulier.'\n    },\n    'espaces-multiples': {\n        label: 'Espaces multiples', severity: 'info',\n        help: 'L’export les réduit à une seule, mais elles gênent la relecture et la recherche.'\n    },\n    'espace-bord': {\n        label: 'Espace en début ou en fin de paragraphe', severity: 'attention',\n        help: 'Une espace au début d’un paragraphe décale la première ligne, à la fin elle peut provoquer une ligne vide à la composition.'\n    },\n    'ponctuation-doublee': {\n        label: 'Ponctuation doublée', severity: 'attention',\n        help: 'Deux virgules, deux points-virgules ou deux signes « : » de suite sont presque toujours une faute de frappe.'\n    },\n    'guillemets-francais': {\n        label: 'Guillemets français non appariés', severity: 'info',\n        help: 'Un « sans » correspondant (ou l’inverse) dans le chapitre. Pensez aux guillemets de continuation, qui sont normaux.'\n    },\n    'retours-forces': {\n        label: 'Retours à la ligne forcés', severity: 'attention',\n        help: 'Un retour à la ligne (Maj+Entrée) au milieu d’un paragraphe reste un saut de ligne forcé dans Word : il casse la justification.'\n    },\n    'mise-en-forme': {\n        label: 'Mise en forme imposée', severity: 'attention',\n        help: 'Police, taille, couleur ou surlignage sont repris par Word et OpenDocument et priment sur les styles de votre mise en page.'\n    },\n    'images': {\n        label: 'Images', severity: 'attention',\n        help: 'Les images collées dans un chapitre ne sont pas reprises par l’export.'\n    },\n    'tableaux': {\n        label: 'Tableaux', severity: 'info',\n        help: 'Les tableaux sont aplatis en paragraphes à l’export.'\n    },\n    'chapitre-vide': {\n        label: 'Chapitre vide', severity: 'attention',\n        help: 'Un chapitre sans texte est exporté avec son titre seul.'\n    },\n    'chapitre-court': {\n        label: 'Chapitre très court', severity: 'info',\n        help: 'Sous le seuil de mots réglé ci-dessus.'\n    },\n    'titre-generique': {\n        label: 'Titre à compléter', severity: 'attention',\n        help: 'Le titre du chapitre est exporté tel quel : « Sans titre » ou « Nouveau chapitre » seraient imprimés.'\n    },\n    'titre-double': {\n        label: 'Titre en double', severity: 'info',\n        help: 'Deux chapitres portent le même titre.'\n    },\n    'statut': {\n        label: 'Chapitre non finalisé', severity: 'info',\n        help: 'Le chapitre n’est pas au statut « Finalisé ». Les statuts « Coupé » et, selon la configuration, « Brouillon » sont exclus de l’export.'\n    }\n};\nfor (const rule of Object.values(RULES)) {\n    rule.label = fr(rule.label);\n    rule.help = fr(rule.help);\n}\n\nconst STATUS_LABELS = { draft: 'Brouillon', writing: 'En cours', review: 'À relire', final: 'Finalisé', cut: 'Coupé' };\n\nconst INVISIBLE = /[\\u200B-\\u200D\\u2060\\uFEFF\\u00AD\\u2028\\u2029]/g;\nconst INVISIBLE_NAMES = {\n    '\\u200B': 'espace de largeur nulle', '\\u200C': 'antiliant de largeur nulle', '\\u200D': 'liant de largeur nulle',\n    '\\u2060': 'lien de mots', '\\uFEFF': 'marque d’ordre des octets', '\\u00AD': 'trait d’union conditionnel',\n    '\\u2028': 'séparateur de ligne', '\\u2029': 'séparateur de paragraphe'\n};\n\nconst DEFAULT_OPTIONS = { disabled: {}, minWords: 100 };\nconst FIX_LIMIT = 30;\n\nfunction plain(char) { return char === ' '; }\n\n/** Construit un résultat avec son contexte (avant / passage / après). */\nfunction makeIssue(context, rule, spec) {\n    const { flat, chapter } = context;\n    const start = spec.start;\n    const length = spec.length || 0;\n    const before = start === null || start === undefined ? '' : flat.slice(Math.max(0, start - 45), start);\n    const match = start === null || start === undefined ? '' : flat.slice(start, start + Math.min(length, 120));\n    const after = start === null || start === undefined ? '' : flat.slice(start + length, start + length + 45);\n    const key = [rule, chapter.id, spec.message, before.slice(-25), match, after.slice(0, 25)].join('|');\n    return {\n        rule,\n        severity: spec.severity || RULES[rule].severity,\n        chapterId: chapter.id,\n        message: fr(spec.message),\n        before, match, after,\n        located: start !== null && start !== undefined,\n        fix: spec.fix || null,\n        key\n    };\n}\n\nfunction fixFor(flat, start, target, replacement, ruleId) {\n    if (!target || target === replacement || target.length > 450 || replacement.length > 450) return null;\n    return {\n        start,\n        end: start + target.length,\n        target,\n        replacement,\n        before: flat.slice(Math.max(0, start - 120), start),\n        after: flat.slice(start + target.length, start + target.length + 130),\n        ruleId\n    };\n}\n\n/**\n * Analyse un chapitre. Retourne la liste des problèmes (corrigeables ou non).\n */\nfunction analyzeChapter(chapter, options, titleCounts) {\n    const opts = { ...DEFAULT_OPTIONS, ...(options || {}) };\n    const enabled = (rule) => !(opts.disabled && opts.disabled[rule]);\n    const issues = [];\n    const status = String(chapter.status || 'draft');\n    const title = String(chapter.title || '').trim();\n    const emptyContext = { flat: '', chapter };\n    const add = (context, rule, spec) => { if (enabled(rule)) issues.push(makeIssue(context, rule, spec)); };\n\n    // Chapitre : titre et statut.\n    if (!title || /^(sans titre|nouveau chapitre|chapitre sans titre|untitled|titre)$/i.test(title)) {\n        add(emptyContext, 'titre-generique', { message: title ? `Le titre « ${title} » est un titre par défaut.` : 'Le chapitre n’a pas de titre.' });\n    }\n    if (titleCounts && title && titleCounts.get(title.toLocaleLowerCase('fr')) > 1) {\n        add(emptyContext, 'titre-double', { message: `Le titre « ${title} » est porté par ${titleCounts.get(title.toLocaleLowerCase('fr'))} chapitres.` });\n    }\n    if (status === 'cut') {\n        add(emptyContext, 'statut', { message: 'Statut « Coupé » : chapitre exclu de l’export par défaut, son texte n’est pas contrôlé.', severity: 'info' });\n        return issues;\n    }\n    if (status !== 'final') {\n        add(emptyContext, 'statut', { message: `Statut « ${STATUS_LABELS[status] || status} ».` });\n    }\n\n    const model = buildModel(chapter.content);\n    const context = { flat: model.flat, chapter };\n    const words = (model.flat.match(/[\\p{L}\\p{N}][^\\s]*/gu) || []).length;\n    if (words === 0) {\n        add(emptyContext, 'chapitre-vide', { message: 'Le chapitre ne contient aucun texte.' });\n    } else if (words < Number(opts.minWords || 0)) {\n        add(emptyContext, 'chapitre-court', { message: `Seulement ${words} mot${words > 1 ? 's' : ''}.` });\n    }\n\n    let invisibleCount = 0;\n    let invisibleSkipped = 0;\n\n    for (const paragraph of model.paragraphs) {\n        const tokens = paragraph.tokens;\n        if (!tokens.length) continue;\n        const paragraphText = tokens.map((token) => token.decoded).join('');\n        if (!paragraphText.trim()) continue;\n        const first = tokens[0];\n        const last = tokens[tokens.length - 1];\n\n        // Espaces en bord de paragraphe.\n        const lead = first.decoded.match(/^[   ]+/);\n        if (lead && first.decoded.trim()) {\n            add(context, 'espace-bord', {\n                message: 'Espace au début du paragraphe.',\n                start: first.flatStart, length: lead[0].length,\n                fix: fixFor(model.flat, first.flatStart, lead[0], '', 'espace-bord')\n            });\n        }\n        const trail = last.decoded.match(/[   ]+$/);\n        if (trail && last.decoded.trim()) {\n            const at = last.flatStart + last.decoded.length - trail[0].length;\n            add(context, 'espace-bord', {\n                message: 'Espace à la fin du paragraphe.',\n                start: at, length: trail[0].length,\n                fix: fixFor(model.flat, at, trail[0], '', 'espace-bord')\n            });\n        }\n\n        // Tiret de dialogue (paragraphes ordinaires et citations).\n        if (paragraph.kind === 'text' || paragraph.kind === 'quote') {\n            const dash = first.decoded.match(/^[   ]*([-‐-‒–−―]|—)(?=([   ]*)(\\S))/);\n            if (dash) {\n                const next = dash[3];\n                const spaces = dash[2];\n                const isEm = dash[1] === '—';\n                const negativeNumber = !isEm && !spaces && /\\d/.test(next);\n                const alone = !isEm && !spaces && /[-–—]/.test(next);\n                if (!negativeNumber && !alone && (!isEm || !spaces)) {\n                    const leading = (dash[0].match(/^[   ]*/) || [''])[0];\n                    const dashStart = first.flatStart + leading.length;\n                    const target = isEm ? '—' : first.decoded.slice(leading.length, leading.length + 1 + spaces.length);\n                    add(context, 'tiret-dialogue', {\n                        message: isEm ? 'Tiret cadratin collé au texte : il faut une espace après.' : 'Le tiret de dialogue doit être un tiret cadratin (—).',\n                        start: dashStart, length: target.length,\n                        fix: fixFor(model.flat, dashStart, target, '— ', 'tiret-dialogue')\n                    });\n                }\n            }\n        }\n\n        // Règles appliquées à chaque morceau de texte.\n        let straightLeft = 0;\n        let straightFirst = null;\n        for (const token of tokens) {\n            const text = token.decoded;\n\n            // Guillemets droits ou anglais appariés dans le même morceau.\n            const fixable = [];\n            text.replace(/\"([^\"\\n]{1,300}?)\"|[“„]([^“”„\\n]{1,300}?)[”“]/g, (all, a, b, index) => {\n                const inner = String(a !== undefined ? a : b).trim();\n                fixable.push({ index, all, inner });\n                return all;\n            });\n            let covered = text;\n            for (const item of fixable) {\n                const start = token.flatStart + item.index;\n                add(context, 'guillemets-droits', {\n                    message: 'Guillemets droits : ils deviendront des guillemets français.',\n                    start, length: item.all.length,\n                    fix: fixFor(model.flat, start, item.all, `«${NBSP}${item.inner}${NBSP}»`, 'guillemets-droits')\n                });\n                covered = covered.replace(item.all, ' ');\n            }\n            const lone = covered.indexOf('\"');\n            if (lone >= 0) {\n                straightLeft += (covered.match(/\"/g) || []).length;\n                if (straightFirst === null) straightFirst = token.flatStart + lone;\n            }\n\n            // Caractères invisibles.\n            INVISIBLE.lastIndex = 0;\n            let found;\n            while ((found = INVISIBLE.exec(text)) !== null) {\n                invisibleCount += 1;\n                if (invisibleCount > 60) { invisibleSkipped += 1; continue; }\n                const start = token.flatStart + found.index;\n                const name = INVISIBLE_NAMES[found[0]] || 'caractère de contrôle';\n                add(context, 'caracteres-invisibles', {\n                    message: `Caractère invisible : ${name}.`,\n                    start, length: 1,\n                    fix: fixFor(model.flat, start, found[0], '', 'caracteres-invisibles')\n                });\n            }\n\n            // Espaces multiples ou mêlées (hors bords de paragraphe, déjà traités).\n            const spaceRun = /[      ]{2,}/g;\n            let run;\n            while ((run = spaceRun.exec(text)) !== null) {\n                const atFirstStart = token === first && run.index === 0;\n                const atLastEnd = token === last && run.index + run[0].length === text.length;\n                if (atFirstStart || atLastEnd) continue;\n                const mixed = /[^ ]/.test(run[0]);\n                const keep = (run[0].match(/[     ]/) || [' '])[0];\n                const start = token.flatStart + run.index;\n                add(context, mixed ? 'espaces-melees' : 'espaces-multiples', {\n                    message: mixed ? 'Espaces mêlées (insécable et ordinaire côte à côte).' : `${run[0].length} espaces de suite.`,\n                    start, length: run[0].length,\n                    fix: fixFor(model.flat, start, run[0], keep, mixed ? 'espaces-melees' : 'espaces-multiples')\n                });\n            }\n\n            // Ponctuation doublée.\n            const repeated = /,,+|;;+|::+/g;\n            let rep;\n            while ((rep = repeated.exec(text)) !== null) {\n                const start = token.flatStart + rep.index;\n                add(context, 'ponctuation-doublee', {\n                    message: `« ${rep[0]} » : signe répété.`,\n                    start, length: rep[0].length,\n                    fix: fixFor(model.flat, start, rep[0], rep[0][0], 'ponctuation-doublee')\n                });\n            }\n            const dots = /(?<!\\.)\\.\\.(?!\\.)/g;\n            let dot;\n            while ((dot = dots.exec(text)) !== null) {\n                const start = token.flatStart + dot.index;\n                add(context, 'ponctuation-doublee', {\n                    message: 'Deux points de suite : faute de frappe ou points de suspension (…) ?',\n                    start, length: 2\n                });\n            }\n        }\n        if (straightLeft > 0) {\n            add(context, 'guillemets-droits', {\n                message: `${straightLeft > 1 ? `${straightLeft} guillemets droits isolés` : 'Guillemet droit isolé'} (sans pendant dans le même morceau de texte) : à corriger à la main.`,\n                start: straightFirst, length: 1\n            });\n        }\n    }\n\n    // Retours à la ligne forcés.\n    for (const item of model.softBreaks.slice(0, 40)) {\n        add(context, 'retours-forces', {\n            message: 'Retour à la ligne forcé au milieu d’un paragraphe : à remplacer par un vrai paragraphe (Entrée).',\n            start: item.flatStart, length: 20\n        });\n    }\n    if (model.softBreaks.length > 40) {\n        add(emptyContext, 'retours-forces', { message: `${model.softBreaks.length - 40} autres retours à la ligne forcés non détaillés.` });\n    }\n\n    // Mise en forme imposée : un résultat par type, avec quelques exemples.\n    const byKind = new Map();\n    for (const item of model.overrides) {\n        for (const kind of item.kinds) {\n            if (!byKind.has(kind)) byKind.set(kind, []);\n            byKind.get(kind).push(item);\n        }\n    }\n    for (const [kind, list] of byKind) {\n        const samples = list.slice(0, 3).map((item) => `« ${item.sample} »`).join(', ');\n        const first = list[0];\n        add(context, 'mise-en-forme', {\n            message: `${list.length} passage${list.length > 1 ? 's' : ''} avec ${kind === 'surlignage' ? 'un surlignage' : kind === 'police' ? 'une police' : kind === 'taille' ? 'une taille' : 'une couleur'} imposé${kind === 'surlignage' || kind === 'police' || kind === 'taille' || kind === 'couleur' ? 'e' : ''}, par exemple ${samples}.`,\n            start: first.flatStart, length: first.sample.length\n        });\n    }\n\n    if (model.images > 0) {\n        add(emptyContext, 'images', { message: `${model.images} image${model.images > 1 ? 's' : ''} dans le chapitre : non reprise${model.images > 1 ? 's' : ''} par l’export.` });\n    }\n    if (model.tables > 0) {\n        add(emptyContext, 'tableaux', { message: `${model.tables} tableau${model.tables > 1 ? 'x' : ''} : aplati${model.tables > 1 ? 's' : ''} en paragraphes à l’export.` });\n    }\n    if (invisibleSkipped > 0) {\n        add(emptyContext, 'caracteres-invisibles', { message: `${invisibleSkipped} autres caractères invisibles non détaillés : corrigez ceux-ci puis relancez le contrôle.` });\n    }\n\n    // Guillemets français : appariement sur tout le chapitre.\n    if (enabled('guillemets-francais')) {\n        const open = [];\n        const orphanClose = [];\n        const flat = model.flat;\n        for (let i = 0; i < flat.length; i += 1) {\n            if (flat[i] === '«') open.push(i);\n            else if (flat[i] === '»') { if (open.length) open.pop(); else orphanClose.push(i); }\n        }\n        for (const pos of orphanClose.slice(0, 5)) {\n            add(context, 'guillemets-francais', { message: 'Guillemet fermant » sans guillemet ouvrant avant lui.', start: pos, length: 1, severity: 'attention' });\n        }\n        for (const pos of open.slice(-5)) {\n            add(context, 'guillemets-francais', { message: 'Guillemet ouvrant « jamais refermé (à vérifier : guillemets de continuation ?).', start: pos, length: 1 });\n        }\n    }\n\n    return issues;\n}\n\n/** Statistiques des styles à prévoir dans la mise en page. */\nfunction styleSummary(chapters) {\n    const total = { chapitres: 0, intertitres: 0, citations: 0, items: 0, italique: 0, gras: 0, exposant: 0 };\n    for (const chapter of chapters) {\n        if (String(chapter.status || '') === 'cut') continue;\n        total.chapitres += 1;\n        const model = buildModel(chapter.content);\n        total.intertitres += model.headings;\n        total.citations += model.quotes;\n        total.items += model.items;\n        total.italique += model.emphasis;\n        total.gras += model.strong;\n        total.exposant += model.superscript;\n    }\n    return total;\n}\n\nfunction countTitles(chapters) {\n    const counts = new Map();\n    for (const chapter of chapters) {\n        if (String(chapter.status || '') === 'cut') continue;\n        const key = String(chapter.title || '').trim().toLocaleLowerCase('fr');\n        if (key) counts.set(key, (counts.get(key) || 0) + 1);\n    }\n    return counts;\n}\n\nif (typeof module !== 'undefined' && module.exports) {\n    module.exports = { buildModel, analyzeChapter, countTitles, styleSummary, decodeEntities, RULES, DEFAULT_OPTIONS, fr, FIX_LIMIT };\n}\n\n// ---------------------------------------------------------------------------\n// Interface\n// ---------------------------------------------------------------------------\n\nif (typeof ecrivain !== 'undefined') {\n    (function ui() {\n        const state = {\n            project: null,\n            chapters: [],\n            issues: [],\n            titleCounts: new Map(),\n            options: { ...DEFAULT_OPTIONS, disabled: {} },\n            ignored: new Set(),\n            filter: 'all',\n            showIgnored: false,\n            expanded: new Set(),\n            busy: false,\n            message: ''\n        };\n\n        const esc = (value) => String(value ?? '')\n            .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')\n            .replaceAll('\"', '&quot;').replaceAll(\"'\", '&#039;');\n\n        /** Affiche un extrait du manuscrit en rendant visibles les espaces particulières. */\n        function visible(text) {\n            return esc(text)\n                .replaceAll(NBSP, '<span class=\"sp\" title=\"espace insécable\">°</span>')\n                .replaceAll(NNBSP, '<span class=\"sp\" title=\"espace fine insécable\">˙</span>')\n                .replaceAll(' ', '<span class=\"sp\" title=\"espace fine\">˙</span>')\n                .replaceAll('\\n', '<span class=\"nl\" title=\"saut de ligne\">⏎</span> ')\n                .replace(INVISIBLE, (char) => `<span class=\"inv\" title=\"${esc(INVISIBLE_NAMES[char] || 'invisible')}\">▯</span>`);\n        }\n\n        async function loadSettings() {\n            try {\n                const saved = await ecrivain.storage.read();\n                if (saved && typeof saved === 'object') {\n                    state.options = {\n                        ...DEFAULT_OPTIONS,\n                        ...(saved.options || {}),\n                        disabled: { ...((saved.options && saved.options.disabled) || {}) }\n                    };\n                    state.ignored = new Set(Array.isArray(saved.ignored) ? saved.ignored.slice(-1500) : []);\n                }\n            } catch (_) { /* première utilisation */ }\n        }\n\n        async function saveSettings() {\n            try {\n                await ecrivain.storage.write({\n                    version: 1,\n                    options: state.options,\n                    ignored: [...state.ignored].slice(-1500)\n                });\n            } catch (error) {\n                state.message = `Réglages non enregistrés : ${error.message || error}`;\n            }\n        }\n\n        function analyzeAll() {\n            state.titleCounts = countTitles(state.chapters);\n            state.issues = [];\n            for (const chapter of state.chapters) {\n                state.issues.push(...analyzeChapter(chapter, state.options, state.titleCounts));\n            }\n        }\n\n        function chapterById(id) { return state.chapters.find((chapter) => chapter.id === id); }\n\n        function visibleIssues() {\n            return state.issues.filter((issue) => state.showIgnored || !state.ignored.has(issue.key));\n        }\n\n        function counts() {\n            const list = state.issues.filter((issue) => !state.ignored.has(issue.key));\n            return {\n                total: list.length,\n                erreur: list.filter((i) => i.severity === 'erreur').length,\n                attention: list.filter((i) => i.severity === 'attention').length,\n                info: list.filter((i) => i.severity === 'info').length,\n                fixable: list.filter((i) => i.fix).length,\n                ignored: state.issues.length - list.length\n            };\n        }\n\n        function filtered() {\n            const list = visibleIssues();\n            if (state.filter === 'fix') return list.filter((issue) => issue.fix);\n            if (['erreur', 'attention', 'info'].includes(state.filter)) return list.filter((issue) => issue.severity === state.filter);\n            return list;\n        }\n\n        const SEVERITY_LABEL = { erreur: 'À corriger', attention: 'Attention', info: 'Info' };\n\n        function renderIssue(issue, index) {\n            const rule = RULES[issue.rule];\n            const ignored = state.ignored.has(issue.key);\n            const excerpt = issue.located\n                ? `<p class=\"excerpt\">${issue.before ? '…' : ''}${visible(issue.before)}<mark>${visible(issue.match) || '▯'}</mark>${visible(issue.after)}${issue.after ? '…' : ''}</p>`\n                : '';\n            const fix = issue.fix\n                ? `<button type=\"button\" class=\"primary\" data-action=\"fix\" data-index=\"${index}\">Corriger</button>`\n                : '';\n            const ignore = ignored\n                ? `<button type=\"button\" data-action=\"unignore\" data-index=\"${index}\">Ne plus ignorer</button>`\n                : `<button type=\"button\" data-action=\"ignore\" data-index=\"${index}\">Ignorer</button>`;\n            return `<li class=\"issue sev-${issue.severity}${ignored ? ' is-ignored' : ''}\">\n                <div class=\"issue-head\">\n                    <span class=\"badge sev-${issue.severity}\">${SEVERITY_LABEL[issue.severity]}</span>\n                    <strong>${esc(rule.label)}</strong>\n                </div>\n                <p>${esc(issue.message)}</p>\n                ${excerpt}\n                <div class=\"issue-actions\">${fix}${ignore}</div>\n            </li>`;\n        }\n\n        function render() {\n            const root = document.getElementById('plugin-root');\n            const c = counts();\n            const styles = styleSummary(state.chapters);\n            const list = filtered();\n            const byChapter = new Map();\n            list.forEach((issue) => {\n                if (!byChapter.has(issue.chapterId)) byChapter.set(issue.chapterId, []);\n                byChapter.get(issue.chapterId).push(issue);\n            });\n\n            const filterButton = (id, label, n) => `<button type=\"button\" class=\"filter${state.filter === id ? ' is-active' : ''}\" data-action=\"filter\" data-filter=\"${id}\">${esc(fr(label))} <span>${n}</span></button>`;\n\n            const rulesHtml = Object.entries(RULES).map(([id, rule]) => `\n                <label class=\"rule\" title=\"${esc(rule.help)}\">\n                    <input type=\"checkbox\" data-rule=\"${id}\" ${state.options.disabled[id] ? '' : 'checked'}>\n                    <span>${esc(rule.label)}</span>\n                </label>`).join('');\n\n            let groups = '';\n            for (const chapter of state.chapters) {\n                const chapterIssues = byChapter.get(chapter.id);\n                if (!chapterIssues || !chapterIssues.length) continue;\n                const fixCount = chapterIssues.filter((issue) => issue.fix && !state.ignored.has(issue.key)).length;\n                const expanded = state.expanded.has(chapter.id);\n                const shown = expanded ? chapterIssues : chapterIssues.slice(0, 40);\n                const hidden = chapterIssues.length - shown.length;\n                groups += `<section class=\"chapter-group\">\n                    <header class=\"chapter-head depth-${Math.min(4, Number(chapter.depth || 0))}\">\n                        <div>\n                            <h3>${esc(chapter.title || 'Sans titre')}</h3>\n                            <small>${chapterIssues.length} résultat${chapterIssues.length > 1 ? 's' : ''} · ${esc(STATUS_LABELS[chapter.status] || 'Brouillon')}</small>\n                        </div>\n                        ${fixCount ? `<button type=\"button\" class=\"primary\" data-action=\"fix-chapter\" data-chapter=\"${esc(chapter.id)}\" ${state.busy ? 'disabled' : ''}>Corriger ${fixCount > FIX_LIMIT ? `les ${FIX_LIMIT} premiers` : `les ${fixCount}`}</button>` : ''}\n                    </header>\n                    <ul class=\"issues\">${shown.map((issue) => renderIssue(issue, state.issues.indexOf(issue))).join('')}</ul>\n                    ${hidden > 0 ? `<button type=\"button\" class=\"more\" data-action=\"expand\" data-chapter=\"${esc(chapter.id)}\">Afficher les ${hidden} autres</button>` : ''}\n                </section>`;\n            }\n            if (!groups) {\n                groups = `<div class=\"all-clear\"><strong>${c.total === 0 ? 'Rien à signaler.' : 'Aucun résultat pour ce filtre.'}</strong><p>${c.total === 0 ? esc(fr('Le manuscrit est prêt pour l’export. Relancez le contrôle après vos prochaines modifications.')) : 'Changez de filtre pour voir les autres résultats.'}</p></div>`;\n            }\n\n            const styleLine = [\n                `${styles.chapitres} chapitre${styles.chapitres > 1 ? 's' : ''} (Titre 1)`,\n                styles.intertitres ? `${styles.intertitres} intertitre${styles.intertitres > 1 ? 's' : ''}` : '',\n                styles.citations ? `${styles.citations} citation${styles.citations > 1 ? 's' : ''}` : '',\n                styles.items ? `${styles.items} élément${styles.items > 1 ? 's' : ''} de liste` : '',\n                styles.italique ? `${styles.italique} passage${styles.italique > 1 ? 's' : ''} en italique` : '',\n                styles.gras ? `${styles.gras} en gras` : '',\n                styles.exposant ? `${styles.exposant} en exposant` : ''\n            ].filter(Boolean).join(' · ');\n\n            root.innerHTML = `\n                <header class=\"plugin-title\">\n                    <div>\n                        <span>AVANT L’EXPORT</span>\n                        <h1>${esc(state.project?.title || 'Manuscrit')}</h1>\n                    </div>\n                    <button type=\"button\" data-action=\"rerun\" ${state.busy ? 'disabled' : ''}>Relancer le contrôle</button>\n                </header>\n                ${state.message ? `<p class=\"notice\">${esc(state.message)}</p>` : ''}\n                <div class=\"summary-grid\">\n                    <article><strong>${state.chapters.length}</strong><span>chapitre${state.chapters.length > 1 ? 's' : ''} lus</span></article>\n                    <article class=\"sev-erreur\"><strong>${c.erreur}</strong><span>à corriger</span></article>\n                    <article class=\"sev-attention\"><strong>${c.attention}</strong><span>attention</span></article>\n                    <article class=\"sev-info\"><strong>${c.info}</strong><span>information${c.info > 1 ? 's' : ''}</span></article>\n                </div>\n                <p class=\"styles-line\"><strong>Styles à prévoir dans la mise en page :</strong> ${esc(styleLine || 'aucun contenu')}.</p>\n                <details class=\"options\">\n                    <summary>Règles du contrôle</summary>\n                    <div class=\"rules\">${rulesHtml}</div>\n                    <label class=\"min-words\">Chapitre « très court » sous <input type=\"number\" min=\"0\" max=\"5000\" step=\"10\" data-option=\"minWords\" value=\"${Number(state.options.minWords || 0)}\"> mots</label>\n                </details>\n                <div class=\"filters\">\n                    ${filterButton('all', 'Tout', c.total + (state.showIgnored ? c.ignored : 0))}\n                    ${filterButton('fix', 'Corrigeables en un clic', c.fixable)}\n                    ${filterButton('erreur', 'À corriger', c.erreur)}\n                    ${filterButton('attention', 'Attention', c.attention)}\n                    ${filterButton('info', 'Infos', c.info)}\n                    ${c.ignored ? `<button type=\"button\" class=\"filter${state.showIgnored ? ' is-active' : ''}\" data-action=\"toggle-ignored\">Ignorés <span>${c.ignored}</span></button>` : ''}\n                </div>\n                ${groups}\n                <p class=\"footnote\">${esc(fr('Les corrections passent par l’historique : chaque correction crée une version du chapitre (Projet → Historique). Inutile de corriger les apostrophes, les points de suspension et les espaces avant ; ? ! : l’export les normalise déjà.'))}</p>`;\n        }\n\n        async function refreshChapter(chapterId) {\n            const fresh = await ecrivain.chapters.get(chapterId);\n            const old = chapterById(chapterId) || {};\n            const index = state.chapters.findIndex((chapter) => chapter.id === chapterId);\n            const merged = { ...old, ...fresh, depth: old.depth || 0 };\n            if (index >= 0) state.chapters[index] = merged;\n            return merged;\n        }\n\n        function reanalyzeChapter(chapterId) {\n            state.issues = state.issues.filter((issue) => issue.chapterId !== chapterId);\n            state.titleCounts = countTitles(state.chapters);\n            const chapter = chapterById(chapterId);\n            if (chapter) state.issues.push(...analyzeChapter(chapter, state.options, state.titleCounts));\n            state.issues.sort((a, b) => state.chapters.findIndex((c) => c.id === a.chapterId) - state.chapters.findIndex((c) => c.id === b.chapterId));\n        }\n\n        async function fixOne(issue) {\n            if (!issue.fix) return;\n            state.busy = true;\n            state.message = '';\n            try {\n                const result = await ecrivain.chapters.applyCorrection(issue.chapterId, issue.fix);\n                if (!result || !result.applied) throw new Error('La correction n’a pas pu être appliquée.');\n                await refreshChapter(issue.chapterId);\n                reanalyzeChapter(issue.chapterId);\n                ecrivain.notify('Correction appliquée.');\n            } catch (error) {\n                state.message = fr(`Correction refusée : ${error.message || error} Corrigez ce passage directement dans le manuscrit.`);\n            } finally {\n                state.busy = false;\n                render();\n            }\n        }\n\n        async function fixChapter(chapterId) {\n            state.busy = true;\n            state.message = '';\n            render();\n            let applied = 0;\n            try {\n                for (let i = 0; i < FIX_LIMIT; i += 1) {\n                    const chapter = await refreshChapter(chapterId);\n                    const next = analyzeChapter(chapter, state.options, state.titleCounts)\n                        .find((issue) => issue.fix && !state.ignored.has(issue.key));\n                    if (!next) break;\n                    const result = await ecrivain.chapters.applyCorrection(chapterId, next.fix);\n                    if (!result || !result.applied) throw new Error('une correction n’a pas pu être appliquée.');\n                    applied += 1;\n                }\n                state.message = fr(`${applied} correction${applied > 1 ? 's' : ''} appliquée${applied > 1 ? 's' : ''}${applied >= FIX_LIMIT ? ` (limite de ${FIX_LIMIT} par clic : relancez pour la suite)` : ''}.`);\n                ecrivain.notify(`${applied} correction${applied > 1 ? 's' : ''} appliquée${applied > 1 ? 's' : ''}.`);\n            } catch (error) {\n                state.message = fr(`Arrêt après ${applied} correction${applied > 1 ? 's' : ''} : ${error.message || error}`);\n            } finally {\n                try { await refreshChapter(chapterId); } catch (_) { /* affichage seulement */ }\n                reanalyzeChapter(chapterId);\n                state.busy = false;\n                render();\n            }\n        }\n\n        async function run() {\n            const root = document.getElementById('plugin-root');\n            root.innerHTML = '<div class=\"analysis-loading\"><strong>Lecture du projet…</strong><span>Écrivain rassemble les chapitres et leur contenu.</span></div>';\n            await loadSettings();\n            state.project = await ecrivain.project.getCurrent();\n            state.chapters = await ecrivain.chapters.readAll();\n            state.message = '';\n            if (!state.chapters.length) {\n                root.innerHTML = '<div class=\"all-clear\"><strong>Aucun chapitre à contrôler.</strong><p>Créez au moins un chapitre dans le projet, puis relancez le contrôle.</p></div>';\n                return;\n            }\n            analyzeAll();\n            render();\n            const c = counts();\n            ecrivain.notify(c.total ? `Contrôle terminé : ${c.total} résultat${c.total > 1 ? 's' : ''}.` : 'Contrôle terminé : rien à signaler.');\n        }\n\n        const root = document.getElementById('plugin-root');\n        root.addEventListener('click', async (event) => {\n            const button = event.target.closest('[data-action]');\n            if (!button || button.disabled) return;\n            const action = button.dataset.action;\n            const issue = button.dataset.index !== undefined ? state.issues[Number(button.dataset.index)] : null;\n            if (action === 'rerun') { await run(); return; }